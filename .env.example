# Copy this file to .env and fill in real values before going live.
# .env is already in .gitignore — never commit real secrets.

PORT=5000
FLASK_DEBUG=0

# PUBLIC_BASE_URL is OPTIONAL. Leave it blank (the default) and the app will
# automatically use whatever host/port each request actually came in on for
# JazzCash's pp_ReturnURL — so the whole app works correctly on ANY port
# without touching this file. Only set this if you're running behind a real
# public domain in production and want that exact URL used instead, e.g.:
# PUBLIC_BASE_URL=https://shakarganj.pk
PUBLIC_BASE_URL=

# ---- Admin account (seeded on first run) ----
# This is the ONLY place these live — change them here before the first run
# if you want different credentials; after the first run, change the
# password by editing the database directly (there's no "forgot password"
# flow yet).
ADMIN_EMAIL=shakarganj@gmail.com
ADMIN_PASSWORD=11223344

# ---- Database ----
# DB_ENGINE=sqlite (default) needs nothing else — a file at
# data/shakarganj.db is created automatically.
#
# DB_ENGINE=mysql connects to a real MySQL/MariaDB server. Run
# `pip install pymysql` first, create an empty database, then fill in:
DB_ENGINE=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=shakarganj

# ---- JazzCash (https://www.jazzcash.com.pk) ----
# Leave these BLANK to run in local sandbox/simulation mode (checkout flow
# is mocked so you can demo end-to-end with no live account). Apply for a
# merchant account through the JazzCash Business/Developer Portal to get
# real values for all three:
JAZZCASH_MODE=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# ---- Support form email delivery (optional for local development) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=
FORM_RECIPIENT_EMAIL=
